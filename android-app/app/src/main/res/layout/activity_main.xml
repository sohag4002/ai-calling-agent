<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Voice Call Gateway"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="হোয়াটসঅ্যাপ লিড-টু-কল অটোমেশন গেটওয়ে"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="18dp"
        android:background="#334155" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="cPanel / Server URL"
        android:textColor="#CBD5E1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#1E293B"
        android:hint="https://your-domain.com"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4F46E5"
        android:padding="14dp"
        android:text="গেটওয়ে চালু করুন"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="স্ট্যাটাস: বন্ধ ❌"
        android:textColor="#F43F5E"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="লাইভ লগ ও অ্যাক্টিভিটি:"
        android:textColor="#CBD5E1"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#1E293B"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="অ্যাপ প্রস্তুত। সার্ভার কানেক্ট করে ব্যাকগ্রাউন্ডে চালু রাখুন..."
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
