# Server Configuration
PORT=5000
NODE_ENV=production
APP_SECRET=ai_voice_agent_secret_key_2026

# AI Brain API Keys (Get free Groq key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Business Profile & AI Persona
BUSINESS_NAME=আমাদের আইটি সার্ভিস
AGENT_NAME=সাদিয়া
AGENT_GENDER=female
SERVICE_DESCRIPTION=ওয়েবসাইট ডিজাইন, ডিজিটাল মার্কেটিং, এবং ফেসবুক বুস্টিং সার্ভিস
DEFAULT_LANGUAGE=bn-BD

# Auto-Call Settings
AUTO_CALL_ENABLED=true
AUTO_CALL_DELAY_SECONDS=10
WORKING_HOURS_START=09:00
WORKING_HOURS_END=23:00

# WhatsApp Settings
WHATSAPP_SESSION_PATH=./whatsapp-auth
FOLLOW_UP_WHATSAPP_MESSAGE_ENABLED=true
